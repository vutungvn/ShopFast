# Copy thành .env.prod rồi điền giá trị thật. KHÔNG commit .env.prod
# Cổng web trên máy: chạy thử ở máy dùng 8080; trên EC2 dùng 80
WEB_PORT=8080

POSTGRES_USER=shopfast
POSTGRES_DB=shopfast
# Chỉ dùng chữ và số (đặt trong URL kết nối DB). Tạo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# Ít nhất 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Mật khẩu cho các tài khoản demo khi chạy seed (đừng dùng MatKhau123 trên production)
SEED_PASSWORD=

# Hạn thanh toán của đơn (phút). Khi demo tự huỷ đơn có thể đặt 2
ORDER_PAYMENT_TIMEOUT_MINUTES=1440

# Chỉ dùng trên server (DEP-06): tên miền và email nhận thông báo từ Let's Encrypt
DOMAIN=
LETSENCRYPT_EMAIL=

