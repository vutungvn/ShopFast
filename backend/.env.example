NODE_ENV=development
PORT=3000

DATABASE_URL=
REDIS_URL=

# SMTP thật để gửi email (vd: smtp.gmail.com, 587). Để trống SMTP_HOST thì chưa gửi email.
SMTP_HOST=
SMTP_PORT=587

# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

SWAGGER_ENABLED=true
