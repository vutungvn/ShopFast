NODE_ENV=development
PORT=3000

# Dùng 127.0.0.1 thay vì localhost: trên Windows "localhost" thử IPv6 (::1) trước, Docker chỉ mở
# cổng IPv4 nên mỗi kết nối mới chậm ~2 giây.
# Vd: postgresql://shopfast:shopfast@127.0.0.1:5434/shopfast?schema=public
DATABASE_URL=
# Vd: redis://127.0.0.1:6380
REDIS_URL=

# SMTP thật để gửi email (vd: smtp.gmail.com, 587). Để trống SMTP_HOST thì chưa gửi email.
SMTP_HOST=
SMTP_PORT=587

# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Hạn thanh toán của đơn (phút), mặc định 24h. Demo có thể đặt 2 để thấy đơn quá hạn
ORDER_PAYMENT_TIMEOUT_MINUTES=1440
# Worker (npm run start:worker:dev) quét và tự huỷ đơn quá hạn sau mỗi khoảng này (giây)
ORDER_EXPIRY_SWEEP_SECONDS=60

# Rate limit: số lớp proxy đứng trước API (production 1 lớp Nginx, chạy trực tiếp thì 0)
TRUST_PROXY_HOPS=0
# Hạn mức chung mỗi THROTTLE_TTL_SECONDS: theo tài khoản / theo IP chưa đăng nhập
THROTTLE_TTL_SECONDS=60
THROTTLE_USER_LIMIT=120
THROTTLE_IP_LIMIT=300

SWAGGER_ENABLED=true
